[Desktop Entry]
Type=Application
Name=kTomato
GenericName=Pomodoro Timer
GenericName[it]=Timer Pomodoro
GenericName[de]=Pomodoro-Timer
GenericName[es]=Temporizador Pomodoro
GenericName[fr]=Minuteur Pomodoro
Comment=Pomodoro timer with work and break statistics
Comment[it]=Timer Pomodoro con statistiche di lavoro e pause
Comment[de]=Pomodoro-Timer mit Statistiken zu Arbeit und Pausen
Comment[es]=Temporizador Pomodoro con estadísticas de trabajo y descansos
Comment[fr]=Minuteur Pomodoro avec statistiques de travail et de pauses
Exec=ktomato
Icon=io.github.mineraleyt.ktomato
Terminal=false
Categories=Qt;Utility;
Keywords=pomodoro;timer;focus;productivity;
Keywords[it]=pomodoro;timer;concentrazione;produttività;
Keywords[de]=pomodoro;timer;fokus;produktivität;
Keywords[es]=pomodoro;temporizador;concentración;productividad;
Keywords[fr]=pomodoro;minuteur;concentration;productivité;
StartupNotify=true
