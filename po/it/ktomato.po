#: src/core/CalendarSync.cpp:995
msgid "kTomato connection test"
msgstr "Prova di connessione di kTomato"

#: src/core/CalendarSync.cpp:1022
msgid "The connection works, but the test event could not be removed (%1)."
msgstr ""
"La connessione funziona, ma non è stato possibile rimuovere l'evento di "
"prova (%1)."

#: src/core/CalendarSync.cpp:1024
msgid "Connection test succeeded"
msgstr "Prova di connessione riuscita"

#: src/core/CalendarSync.cpp:1034
msgid "Enter the server address, user name and password first."
msgstr "Inserisci prima l'indirizzo del server, il nome utente e la password."

#: src/core/CalendarSync.cpp:1041
msgid "Looking for calendars…"
msgstr "Ricerca dei calendari in corso…"

#: src/core/CalendarSync.cpp:1079 src/core/CalendarSync.cpp:1112
msgid "No calendars were found at this address."
msgstr "Nessun calendario trovato a questo indirizzo."

#: src/core/CalendarSync.cpp:1127
msgid "Enter the Nextcloud address first, for example %1"
msgstr "Inserisci prima l'indirizzo di Nextcloud, ad esempio %1"

#: src/core/CalendarSync.cpp:1134
msgid "Contacting the server…"
msgstr "Connessione al server in corso…"

#: src/core/CalendarSync.cpp:1152
msgid "This does not look like a Nextcloud server."
msgstr "Questo non sembra un server Nextcloud."

#: src/core/CalendarSync.cpp:1161 src/core/CalendarSync.cpp:1260
msgid "The server gave an unexpected answer to the login request."
msgstr "Il server ha dato una risposta inattesa alla richiesta di accesso."

#: src/core/CalendarSync.cpp:1170
msgid "The server redirected the login to a different host; it was refused."
msgstr ""
"Il server ha reindirizzato l'accesso a un host diverso; la richiesta è stata "
"rifiutata."

#: src/core/CalendarSync.cpp:1179
msgid "Waiting for you to authorize kTomato in the browser…"
msgstr "In attesa che autorizzi kTomato nel browser…"

#: src/core/CalendarSync.cpp:1215
msgid "The login was not completed in time. Please try again."
msgstr "L'accesso non è stato completato in tempo. Riprova."

#: src/core/CalendarSync.cpp:1254
msgid ""
"The server returned an address that does not match the one you entered; the "
"login was refused."
msgstr ""
"Il server ha restituito un indirizzo diverso da quello inserito; l'accesso è "
"stato rifiutato."

