#: src/core/CalendarSync.cpp:213
msgid "Plain %1 addresses are not allowed because the password would be sent unencrypted. Use an %2 address."
msgstr "Gli indirizzi %1 semplici non sono consentiti perché la password verrebbe inviata senza cifratura. Usa un indirizzo %2."

