msgid "Connected as %1"
msgstr "Connesso come %1"

#: src/core/CalendarSync.cpp:899
msgid "Calendar not found"
msgstr "Calendario non trovato"

#: src/core/CalendarSync.cpp:901
msgid "Server answered HTTP %1"
msgstr "Il server ha risposto con HTTP %1"

#: src/core/CalendarSync.cpp:903
msgid "The server could not be reached"
msgstr "Impossibile raggiungere il server"

#: src/core/CalendarSync.cpp:1044
msgid "The calendar must be on the Nextcloud server you signed in to."
msgstr "Il calendario deve trovarsi sul server Nextcloud a cui hai effettuato l'accesso."

#: src/core/CalendarSync.cpp:1067
msgid "Too many calendar events are waiting to be sent: the oldest one was dropped."
msgstr "Troppi eventi del calendario sono in attesa di invio: il più vecchio è stato scartato."

#: src/core/CalendarSync.cpp:1206
msgid "The server refused an event (HTTP %1); it was skipped."
msgstr "Il server ha rifiutato un evento (HTTP %1); è stato saltato."

#: src/core/CalendarSync.cpp:1252
msgid "Testing the connection…"
msgstr "Verifica della connessione in corso…"

#: src/core/CalendarSync.cpp:1258
msgid "kTomato connection test"
msgstr "Prova di connessione di kTomato"

#: src/core/CalendarSync.cpp:1288
msgid "The connection works, but the test event could not be removed yet (%1). kTomato will try again later."
msgstr "La connessione funziona, ma non è ancora stato possibile rimuovere l'evento di prova (%1). kTomato riproverà più tardi."

#: src/core/CalendarSync.cpp:1291
msgid "Connection test succeeded"
msgstr "Prova di connessione riuscita"

#: src/core/CalendarSync.cpp:1301
msgid "Enter the server address, user name and password first."
msgstr "Inserisci prima l'indirizzo del server, il nome utente e la password."

#: src/core/CalendarSync.cpp:1308
msgid "Looking for calendars…"
msgstr "Ricerca dei calendari in corso…"

#: src/core/CalendarSync.cpp:1347 src/core/CalendarSync.cpp:1388
msgid "No calendars were found at this address."
msgstr "Nessun calendario trovato a questo indirizzo."

#: src/core/CalendarSync.cpp:1403
msgid "Enter the Nextcloud address first, for example %1"
msgstr "Inserisci prima l'indirizzo di Nextcloud, ad esempio %1"

#: src/core/CalendarSync.cpp:1410
msgid "Contacting the server…"
msgstr "Connessione al server in corso…"

#: src/core/CalendarSync.cpp:1428
msgid "This does not look like a Nextcloud server."
msgstr "Questo non sembra un server Nextcloud."

#: src/core/CalendarSync.cpp:1437 src/core/CalendarSync.cpp:1539
msgid "The server gave an unexpected answer to the login request."
msgstr "Il server ha dato una risposta inattesa alla richiesta di accesso."

#: src/core/CalendarSync.cpp:1449
msgid "The server redirected the login to a different host; it was refused."
msgstr "Il server ha reindirizzato l'accesso a un host diverso; la richiesta è stata rifiutata."

#: src/core/CalendarSync.cpp:1458
msgid "Waiting for you to authorize kTomato in the browser…"
msgstr "In attesa che autorizzi kTomato nel browser…"

#: src/core/CalendarSync.cpp:1494
msgid "The login was not completed in time. Please try again."
msgstr "L'accesso non è stato completato in tempo. Riprova."

#: src/core/CalendarSync.cpp:1533
msgid "The server returned an address that does not match the one you entered; the login was refused."
msgstr "Il server ha restituito un indirizzo diverso da quello inserito; l'accesso è stato rifiutato."

