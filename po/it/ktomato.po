msgstr "Accesso effettuato come %1. Scegli un calendario per terminare."

#: src/core/CalendarSync.cpp:884
msgid "Not configured"
msgstr "Non configurato"

#: src/core/CalendarSync.cpp:887
msgid "Could not send events to the calendar; trying again later"
msgstr "Impossibile inviare gli eventi al calendario; nuovo tentativo più tardi"

