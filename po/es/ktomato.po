msgstr[0] "%1 evento esperando ser enviado"
msgstr[1] "%1 eventos esperando ser enviados"

#: src/qml/pages/AppSettingsPage.qml:905
msgid ""
"When enabled, kTomato sends the name of your timer, its category and the "
"time of each finished work session to the calendar server you choose."
msgstr ""
"Si se activa, kTomato envía al servidor de calendario que elijas el nombre "
"de tu temporizador, su categoría y la hora de cada sesión de trabajo "
"terminada."

